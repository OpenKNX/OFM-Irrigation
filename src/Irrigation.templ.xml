                <!-- Byte 1: Niederschlagsrate -->  
                <Parameter Id="%AID%_UP-%TT%%CC%005" Name="CH%C%NiederschlagsrateValue" ParameterType="%AID%_PT-IRRNiederschlagsrate" Text="Niederschlagsrate der Zone [mm/h]" Offset="1" BitOffset="0" Value="10" />
